            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "terminal",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "guides/api-keys",
              "api-reference/authentication",
              "api-reference/pagination",
              "api-reference/errors",
              "api-reference/client-assessment-recipe",
              "api-reference/manage-clients-recipe",
              "api-reference/refresh-evidence",
              "api-reference/link-source-clients",
              "api-reference/create-standard-recipe",
              "api-reference/activate-standard-draft",
              "api-reference/evaluate-one-client"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api-reference/live-schema"
            ]
          },
          {
            "group": "Organizations",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "GET /api/v1/organizations",
              "GET /api/v1/organizations/{organization_id}"
            ]
          },
          {
            "group": "Standards",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "GET /api/v1/standards",
              "GET /api/v1/standards/{standard_id}",
              "GET /api/v1/standards/{standard_id}/controls",
              "GET /api/v1/standards/{standard_id}/activation-preview",
              "GET /api/v1/standards/{standard_id}/evaluation-preview",
              "GET /api/v1/standards/{standard_id}/evaluation-requests/{operation_id}"
            ]
          },
          {
            "group": "Alignment",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "GET /api/v1/organizations/{organization_id}/compliance",
              "GET /api/v1/organizations/{organization_id}/compliance/trend"
            ]
          },
          {
            "group": "Detections",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "GET /api/v1/detections",
              "GET /api/v1/detections/{detection_id}"
            ]
          },
          {
            "group": "Evidence",
            "openapi": "/api-reference/openapi.json",
            "pages": [
              "GET /api/v1/facts",
              "GET /api/v1/integrations/{integration_id}/client-mapping-candidates",
              "GET /api/v1/integrations/{integration_id}/sync-operations/{operation_id}"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "plug",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "mcp/introduction",
              "mcp/connect",
              "mcp/manage-clients",
              "mcp/copy-standard-draft",
              "mcp/activate-standard-draft",
              "mcp/evaluate-one-client",
              "mcp/request-review",
              "mcp/refresh-evidence",
              "mcp/link-source-clients"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "mcp/tools",
              "mcp/security"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction"
    },
    {
      "source": "/index",
      "destination": "/introduction"
    }
  ],
  "api": {
    "playground": {
      "display": "none"
    }
  }
}
