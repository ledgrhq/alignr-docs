{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Alignr",
  "description": "Set up Alignr, connect your client environments, and build with the API and MCP server.",
  "colors": {
    "primary": "#000000",
    "light": "#EBECED",
    "dark": "#767676"
  },
  "background": {
    "color": {
      "dark": "#000000"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://alignr.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Alignr",
      "href": "https://app.alignr.io"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction",
              "journeys/visual-tour",
              "journeys/evaluate-alignr",
              "guides/setup-wizard",
              "quickstart",
              {
                "group": "Your first assessment",
                "pages": [
                  "journeys/first-assessment",
                  "journeys/connect-and-map",
                  "journeys/read-your-first-result",
                  "journeys/close-the-loop"
                ]
              }
            ]
          },
          {
            "group": "Explore Alignr",
            "pages": [
              {
                "group": "Set up your workspace",
                "pages": [
                  "guides/configure-client",
                  "guides/organizations",
                  "guides/client-microsoft-connections",
                  "guides/standards",
                  "guides/build-or-import-standard"
                ]
              },
              {
                "group": "Connect your tools",
                "pages": [
                  "guides/integrations",
                  "guides/integration-catalogue",
                  {
                    "group": "Integration setup guides",
                    "pages": [
                      "integrations/microsoft-setup",
                      "integrations/meraki-setup",
                      "integrations/identity",
                      "integrations/psa-rmm",
                      "integrations/network",
                      "integrations/unifi-network",
                      "integrations/sonicwall-nsm",
                      "integrations/backup-security",
                      "integrations/email-licensing",
                      "integrations/directories"
                    ]
                  },
                  "guides/maintain-integrations",
                  "guides/domain-checks"
                ]
              },
              {
                "group": "Manage your workspace",
                "pages": [
                  "guides/settings",
                  "guides/account-and-team",
                  "guides/sign-in-recovery",
                  "guides/workspace-health",
                  "guides/security-and-data",
                  "guides/billing-and-support"
                ]
              },
              {
                "group": "Day-to-day work",
                "pages": [
                  "guides/daily-review",
                  "guides/triage-issues",
                  "guides/remediation",
                  "guides/ask-alignr",
                  "guides/client-reviews",
                  "guides/risk-and-roadmap"
                ]
              },
              {
                "group": "Reports and client portal",
                "pages": [
                  "journeys/client-meeting",
                  "guides/client-reports",
                  "guides/client-portal"
                ]
