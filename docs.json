                    "group": "Control recipes",
                    "pages": [
                      "controls/recipes/overview",
                      "controls/recipes/vulnerability-limit",
                      "controls/recipes/backup-confidence"
                    ]
                  },
                  {
                    "group": "Baseline categories",
                    "pages": [
                      "controls/baselines/identity",
                      "controls/baselines/endpoints",
                      "controls/baselines/backup",
                      "controls/baselines/vulnerability",
                      "controls/baselines/licensing",
                      "controls/baselines/network",
                      "controls/baselines/email",
                      "controls/baselines/external"
